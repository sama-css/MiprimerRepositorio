Algoritmo Promedio
	Definir sumando1, sumando2, sumando3 Como Entero
	Escribir 'Ingrese el primer número '
	Leer sumando1
	Escribir 'Ingrese el segundo número '
	Leer sumando2
	Escribir 'Ingrese el tercer número '
	Leer sumando3
	
	Si sumando1>0 Entonces
		totalsuma <- sumando1+sumando2+sumando3
	FinSi
	Si totalsuma es entero Entonces
		total= totalsuma/3
	FinSi
	Escribir ' El promedio de los 3 números es ', total
FinAlgoritmo