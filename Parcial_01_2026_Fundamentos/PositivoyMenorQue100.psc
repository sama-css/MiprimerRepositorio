Algoritmo PositivoyMenorQue100
	Definir num, min, max Como Entero
	min<-0
	max<-100
	Escribir " Ingrese un número positivo y menor que 100 "
	Leer num
	Si num es positivo y num<max y num>min Entonces
		respuesta=Verdadero
		Escribir respuesta
	SiNo
		respuesta=Falso
		Escribir respuesta
	Fin Si
FinAlgoritmo
