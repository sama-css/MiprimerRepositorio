Algoritmo ProductoyCociente
	Definir num1, num2 Como Entero
	Escribir " Ingrese un número para múltiplicar y para dividir "
	Leer num1
	Escribir " Ingrese un número para múltiplicar y para dividir "
	Leer num2
	
	Si num1 es entero Entonces
		total1=num1*num2
		total2=num1/num2
	FinSi
	Escribir " El producto de ",num1 " y ", num2 " es ", total1
	Escribir " El cociente de ",num1 " y ", num2 " es ", total2
FinAlgoritmo
