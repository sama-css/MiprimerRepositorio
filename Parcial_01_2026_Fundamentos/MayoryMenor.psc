Algoritmo MayoryMenor
	Definir num1, num2 Como Entero
	Escribir " Ingrese un número para comparar "
	Leer num1
	Escribir " Ingrese un número para comparar "
	Leer num2
	
	Si num1<num2 Entonces
		Escribir num1, " < ", num2
	Fin Si
	Si num1>num2 Entonces
		Escribir num1, " > ", num2
	FinSi
	Si num1=num2 Entonces
		Escribir num1, " = ", num2
	FinSi
FinAlgoritmo
