Algoritmo SumayResta
	Definir num1, num2 Como Entero
	Escribir " Ingrese un número para sumar y para restar "
	Leer num1
	Escribir " Ingrese un número para sumar y para restar "
	Leer num2
	
	Si num1 es entero Entonces
		total1=num1+num2
		total2=num1-num2
	FinSi
	Escribir " El resultado de la suma es ", total1
	Escribir " El resultado de la resta es ", total2
FinAlgoritmo
